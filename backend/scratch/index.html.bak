<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Meridian — Research Assistant</title>
<style>
  :root {
    --bg: #14181c;
    --divider: #262b31;
    --text: #edeae2;
    --muted: #9099a1;
    --accent: #c9a227;
    --accent-dim: #7d661f;
    --on-accent: #14181c;
    --error: #c1554b;
    --scrim: rgba(0, 0, 0, 0.45);

    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  :root[data-theme="light"] {
    --bg: #f5f1e8;
    --divider: #ddd6c4;
    --text: #1e2124;
    --muted: #6b6f76;
    --accent: #8a6d1e;
    --accent-dim: #b9a26a;
    --on-accent: #f5f1e8;
    --error: #a83b31;
    --scrim: rgba(30, 33, 36, 0.25);
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
  }

  body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 64px 24px 96px;
  }

  main {
    width: 100%;
    max-width: 640px;
  }

  header {
    margin-bottom: 40px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .header-text { min-width: 0; }

  .wordmark {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: 0.01em;
    margin: 0 0 6px;
  }

  .wordmark .dot { color: var(--accent); }

  .subhead {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  button#settings-btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--muted);
    font-family: var(--sans);
    font-size: 13px;
    padding: 7px 14px;
    border-radius: 3px;
    cursor: pointer;
    flex: none;
    transition: color 120ms ease, border-color 120ms ease;
  }

  button#settings-btn:hover {
    color: var(--text);
    border-color: var(--muted);
  }

  .divider {
    border: none;
    border-top: 1px solid var(--divider);
    margin: 32px 0;
  }

  /* --- Model selector --- */

  .model-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .model-row .model-label {
    font-size: 13px;
    color: var(--muted);
  }

  .model-select {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .model-select button {
    appearance: none;
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--muted);
    font-family: var(--sans);
    font-size: 12px;
    padding: 5px 12px;
    border-radius: 999px;
    cursor: pointer;
    transition: color 120ms ease, border-color 120ms ease, background-color 120ms ease;
  }

  .model-select button.active {
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }

  .model-select button:hover:not(.active) {
    color: var(--text);
    border-color: var(--muted);
  }

  .model-hint {
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }

  /* --- Speech-to-text --- */

  .speech-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  button#mic-btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--muted);
    font-family: var(--sans);
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 3px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: color 120ms ease, border-color 120ms ease;
  }

  button#mic-btn:hover:not(:disabled) {
    color: var(--text);
    border-color: var(--muted);
  }

  button#mic-btn:disabled {
    color: var(--muted);
    opacity: 0.5;
    cursor: not-allowed;
  }

  button#mic-btn .mic-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--divider);
    flex: none;
  }

  button#mic-btn.listening {
    color: var(--accent);
    border-color: var(--accent);
  }

  button#mic-btn.listening .mic-dot {
    background: var(--accent);
    animation: mic-pulse 1.1s ease-in-out infinite;
  }

  @keyframes mic-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.6); opacity: 0.6; }
  }

  /* --- Input --- */

  .input-row {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .composer-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  textarea {
    width: 100%;
    resize: vertical;
    min-height: 96px;
    background: transparent;
    border: 1px solid var(--divider);
    border-radius: 4px;
    color: var(--text);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.55;
    padding: 14px 16px;
  }

  textarea::placeholder { color: var(--muted); }

  textarea:focus,
  button:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .input-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }



  button#send-btn {
    appearance: none;
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--accent);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 9px 20px;
    border-radius: 3px;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }

  button#send-btn:hover:not(:disabled) {
    background: var(--accent);
    color: var(--on-accent);
  }

  button#send-btn:disabled {
    border-color: var(--divider);
    color: var(--muted);
    cursor: not-allowed;
  }

  .error-text {
    color: var(--error);
    font-size: 14px;
    margin: 12px 0 0;
    display: none;
  }

  /* --- Progress --- */

  #progress-section { display: none; }

  .progress-caption {
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 14px;
  }

  .progress-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .progress-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 14px;
    color: var(--muted);
    transition: color 200ms ease;
  }

  .progress-list li .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--divider);
    flex: none;
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .progress-list li.active {
    color: var(--text);
    font-weight: 500;
  }
  .progress-list li.active .dot {
    background: var(--accent);
    transform: scale(1.4);
  }

  .progress-list li.done { color: var(--text); }
  .progress-list li.done .dot { background: var(--accent-dim); }

  /* --- Report --- */

  #report-section { display: none; }

  .report-title {
    font-family: var(--serif);
    font-size: 29px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0 0 18px;
  }

  .report-summary {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 30px;
  }

  h3.section-label {
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0.01em;
    color: var(--muted);
    font-weight: 500;
    margin: 0 0 12px;
  }

  ul.key-findings {
    margin: 0 0 32px;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.7;
  }

  ul.key-findings li {
    margin-bottom: 6px;
  }

  .finding {
    margin: 0 0 24px;
    padding-top: 24px;
    border-top: 1px solid var(--divider);
  }

  .finding:first-child {
    padding-top: 0;
    border-top: none;
  }

  .finding h4 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.01em;
    margin: 0 0 8px;
  }

  .finding p {
    font-size: 15px;
    line-height: 1.65;
    margin: 0 0 8px;
    color: var(--text);
  }

  .finding ul {
    margin: 0 0 8px;
    padding-left: 20px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
  }

  .finding ul li {
    margin-bottom: 4px;
  }

  .finding .finding-sources {
    font-size: 13px;
    color: var(--muted);
  }

  .finding .finding-sources a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  ol.sources-list {
    margin: 0;
    padding-left: 20px;
    font-size: 14px;
    line-height: 1.6;
  }

  ol.sources-list li {
    margin-bottom: 10px;
  }

  ol.sources-list li:last-child {
    margin-bottom: 0;
  }

  ol.sources-list a {
    color: var(--accent);
    text-decoration: none;
  }

  ol.sources-list a:hover { text-decoration: underline; }

  ol.sources-list .source-url {
    color: var(--muted);
    font-size: 13px;
    display: block;
  }



  /* --- Settings overlay --- */

  #settings-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--scrim);
    align-items: flex-start;
    justify-content: center;
    padding: 64px 24px;
    z-index: 10;
  }

  #settings-overlay.open { display: flex; }

  .settings-panel {
    width: 100%;
    max-width: 460px;
    background: var(--bg);
    border: 1px solid var(--divider);
    border-radius: 4px;
    padding: 28px 28px 24px;
  }

  .settings-panel h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 20px;
    margin: 0 0 6px;
  }

  .settings-note {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
    margin: 0 0 24px;
  }

  .settings-group {
    margin-bottom: 22px;
  }

  .settings-group h3 {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .field-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 12px;
  }

  .field-row label {
    font-size: 13px;
    color: var(--muted);
  }

  .field-row input[type="text"],
  .field-row input[type="password"] {
    background: transparent;
    border: 1px solid var(--divider);
    border-radius: 3px;
    color: var(--text);
    font-family: var(--sans);
    font-size: 14px;
    padding: 8px 10px;
  }

  /* --- Per-provider API key rows (Inbuilt On/Off) --- */

  .provider-key-row {
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--divider);
  }

  .provider-key-row:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: none;
  }

  .provider-key-toggle-row {
    margin-bottom: 0;
  }

  .custom-key-field {
    display: none;
    margin-top: 12px;
  }

  .custom-key-field.open { display: block; }

  .custom-key-field label {
    font-size: 13px;
    color: var(--muted);
    display: block;
    margin-bottom: 4px;
  }

  .custom-key-input-row {
    display: flex;
    gap: 8px;
  }

  .custom-key-input-row input[type="password"] {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 1px solid var(--divider);
    border-radius: 3px;
    color: var(--text);
    font-family: var(--sans);
    font-size: 14px;
    padding: 8px 10px;
  }

  button.save-key-btn {
    appearance: none;
    border: 1px solid var(--divider);
    background: transparent;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 13px;
    padding: 8px 14px;
    border-radius: 3px;
    cursor: pointer;
    flex: none;
    transition: color 120ms ease, border-color 120ms ease;
  }

  button.save-key-btn:hover {
    color: var(--text);
    border-color: var(--muted);
  }

  .save-confirm {
    font-size: 12px;
    color: var(--accent);
    margin: 6px 0 0;
    min-height: 15px;
  }

  .tavily-status {
    font-size: 13px;
    color: var(--muted);
  }

  .theme-toggle {
    display: flex;
    gap: 6px;
  }

  .theme-toggle button {
    appearance: none;
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--muted);
    font-family: var(--sans);
    font-size: 13px;
    padding: 7px 16px;
    border-radius: 3px;
    cursor: pointer;
  }

  .theme-toggle button.active {
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }

  .settings-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--divider);
  }

  .settings-actions button#settings-close {
    appearance: none;
    background: transparent;
    border: none;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 13px;
    cursor: pointer;
    padding: 8px 0;
  }

  .settings-actions button#settings-close:hover { color: var(--text); }

  .settings-actions button#settings-save {
    appearance: none;
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--accent);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    padding: 9px 20px;
    border-radius: 3px;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .settings-actions button#settings-save:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }

  /* --- Responsive (mobile) --- */

  @media (max-width: 480px) {
    body {
      padding: 40px 18px 72px;
    }

    .wordmark {
      font-size: 25px;
    }

    header {
      margin-bottom: 32px;
    }

    .report-title {
      font-size: 24px;
    }

    #settings-overlay {
      padding: 32px 16px;
      align-items: center;
    }

    .settings-panel {
      padding: 22px 20px 20px;
    }
  }
</style>
</head>
<body>
  <main>
    <header>
      <div class="header-text">
        <p class="wordmark">Meridian<span class="dot">.</span></p>
        <p class="subhead">Ask a research question. Watch it work. Read what it finds.</p>
      </div>
      <button id="settings-btn" type="button">Settings</button>
    </header>

    <section class="input-row">
      <div class="composer-meta">
        <div class="model-row">
          <span class="model-label">Model</span>
          <div class="model-select" id="model-select">
            <button type="button" data-provider="gemini" class="active">Gemini</button>
            <button type="button" data-provider="nvidia">NVIDIA</button>
            <button type="button" data-provider="groq">Groq</button>
          </div>
        </div>
        <p class="model-hint">Gemini is tried first; NVIDIA and Groq are used automatically as fallbacks.</p>

        <div class="speech-row">
          <button id="mic-btn" type="button" title="Speak your research question">
            <span class="mic-dot"></span>
            <span id="mic-btn-label">Speak</span>
          </button>
          <div class="model-select" id="speech-lang-select">
            <button type="button" data-lang="en-US" class="active">English</button>
            <button type="button" data-lang="ta-IN" title="Also recognizes mixed Tamil-English speech">Tamil</button>
          </div>
        </div>
      </div>

      <textarea
        id="prompt-input"
        placeholder="What do you want to research?"
        rows="3"
      ></textarea>
      <div class="input-actions">
        <button id="send-btn" type="button">Send</button>
      </div>
      <p class="error-text" id="error-text"></p>
    </section>



    <hr class="divider" />

    <section id="progress-section">
      <p class="progress-caption" id="progress-caption">Working on it —</p>
      <ul class="progress-list" id="progress-list"></ul>
    </section>

    <div id="report-divider" style="display:none;"><hr class="divider" /></div>

    <section id="report-section">
      <h1 class="report-title" id="report-title"></h1>
      <p class="report-summary" id="report-summary"></p>

      <h3 class="section-label">Key findings</h3>
      <ul class="key-findings" id="key-findings"></ul>

      <div id="findings-container"></div>

      <h3 class="section-label">Sources</h3>
      <ol class="sources-list" id="sources-list"></ol>
    </section>
  </main>

  <div id="settings-overlay">
    <div class="settings-panel">
      <h2>Settings</h2>
      <p class="settings-note">
        API key toggles and any key you enter here are stored only in this
        browser (localStorage). When a provider's toggle is On, requests use
        the app's own configured key for it. When Off, your key below is
        sent with your request only — never stored on the server, never
        shown outside this password field.
      </p>

      <div class="settings-group">
        <h3>API keys</h3>

        <div class="provider-key-row" data-provider="gemini">
          <div class="model-row provider-key-toggle-row">
            <span class="model-label">Gemini — Inbuilt API Key</span>
            <div class="model-select inbuilt-toggle" data-provider="gemini">
              <button type="button" data-value="on" class="active">On</button>
              <button type="button" data-value="off">Off</button>
            </div>
          </div>
          <div class="custom-key-field" data-provider="gemini">
            <label for="key-gemini">Your API Key</label>
            <div class="custom-key-input-row">
              <input type="password" id="key-gemini" autocomplete="off" placeholder="Paste your Gemini API key" />
              <button type="button" class="save-key-btn" data-provider="gemini">Save</button>
            </div>
            <p class="save-confirm" id="save-confirm-gemini"></p>
          </div>
        </div>

        <div class="provider-key-row" data-provider="nvidia">
          <div class="model-row provider-key-toggle-row">
            <span class="model-label">NVIDIA — Inbuilt API Key</span>
            <div class="model-select inbuilt-toggle" data-provider="nvidia">
              <button type="button" data-value="on" class="active">On</button>
              <button type="button" data-value="off">Off</button>
            </div>
          </div>
          <div class="custom-key-field" data-provider="nvidia">
            <label for="key-nvidia">Your API Key</label>
            <div class="custom-key-input-row">
              <input type="password" id="key-nvidia" autocomplete="off" placeholder="Paste your NVIDIA API key" />
              <button type="button" class="save-key-btn" data-provider="nvidia">Save</button>
            </div>
            <p class="save-confirm" id="save-confirm-nvidia"></p>
          </div>
        </div>

        <div class="provider-key-row" data-provider="groq">
          <div class="model-row provider-key-toggle-row">
            <span class="model-label">Groq — Inbuilt API Key</span>
            <div class="model-select inbuilt-toggle" data-provider="groq">
              <button type="button" data-value="on" class="active">On</button>
              <button type="button" data-value="off">Off</button>
            </div>
          </div>
          <div class="custom-key-field" data-provider="groq">
            <label for="key-groq">Your API Key</label>
            <div class="custom-key-input-row">
              <input type="password" id="key-groq" autocomplete="off" placeholder="Paste your Groq API key" />
              <button type="button" class="save-key-btn" data-provider="groq">Save</button>
            </div>
            <p class="save-confirm" id="save-confirm-groq"></p>
          </div>
        </div>

        <div class="provider-key-row tavily-row">
          <div class="model-row provider-key-toggle-row">
            <span class="model-label">Tavily</span>
            <span class="tavily-status">Always uses the app's configured key</span>
          </div>
        </div>
      </div>

      <div class="settings-group">
        <h3>Model names</h3>
        <div class="field-row">
          <label for="model-gemini">Gemini</label>
          <input type="text" id="model-gemini" placeholder="gemini-1.5-flash" />
        </div>
        <div class="field-row">
          <label for="model-nvidia">NVIDIA</label>
          <input type="text" id="model-nvidia" placeholder="meta/llama-3.1-8b-instruct" />
        </div>
        <div class="field-row">
          <label for="model-groq">Groq</label>
          <input type="text" id="model-groq" placeholder="llama-3.1-8b-instant" />
        </div>
      </div>

      <div class="settings-group">
        <h3>Appearance</h3>
        <div class="theme-toggle" id="theme-toggle">
          <button type="button" data-theme="dark" class="active">Dark</button>
          <button type="button" data-theme="light">Light</button>
        </div>
      </div>

      <div class="settings-actions">
        <button id="settings-close" type="button">Close</button>
        <button id="settings-save" type="button">Save</button>
      </div>
    </div>
  </div>

  <script>
    // The backend has no static-file server yet, so this page is opened
    // directly (file://) or from a separate static server, hence an
    // absolute API base rather than a relative path. Matches the README's
    // `uvicorn main:app --reload` default.
    const API_BASE = "http://127.0.0.1:8000";

    const STEPS = [
      { node: "analyze", label: "Reading your request" },
      { node: "plan", label: "Planning the research" },
      { node: "search", label: "Searching sources" },
      { node: "process", label: "Reviewing results" },
      { node: "summarize", label: "Synthesizing findings" },
      { node: "validate", label: "Checking findings" },
      { node: "quality_check", label: "Assessing coverage" },
      { node: "report", label: "Writing the report" },
    ];

    const promptInput = document.getElementById("prompt-input");
    const sendBtn = document.getElementById("send-btn");
    const errorText = document.getElementById("error-text");

    const progressSection = document.getElementById("progress-section");
    const progressCaption = document.getElementById("progress-caption");
    const progressList = document.getElementById("progress-list");

    const reportDivider = document.getElementById("report-divider");
    const reportSection = document.getElementById("report-section");
    const reportTitle = document.getElementById("report-title");
    const reportSummary = document.getElementById("report-summary");
    const keyFindingsEl = document.getElementById("key-findings");
    const findingsContainer = document.getElementById("findings-container");
    const sourcesList = document.getElementById("sources-list");

    // --- Settings (Step: Model Selector + Settings panel) ---------------
    // Everything below is additive UI chrome: persisted locally via
    // localStorage. It does not alter the research pipeline or streaming
    // logic below (buildProgressList / setProgressState / renderReport /
    // parseSseBlock / runResearch's SSE handling are all unchanged).

    const SETTINGS_KEY = "meridian_settings_v1";
    const KEY_PROVIDERS = ["gemini", "nvidia", "groq"];
    const DEFAULT_SETTINGS = {
      provider: "gemini",
      theme: "dark",
      useInbuiltKey: { gemini: true, nvidia: true, groq: true },
      keys: { gemini: "", nvidia: "", groq: "" },
      models: {
        gemini: "gemini-1.5-flash",
        nvidia: "meta/llama-3.1-8b-instruct",
        groq: "llama-3.1-8b-instant",
      },
    };

    function loadSettings() {
      try {
        const raw = localStorage.getItem(SETTINGS_KEY);
        if (!raw) return { ...DEFAULT_SETTINGS };
        const parsed = JSON.parse(raw);
        return {
          ...DEFAULT_SETTINGS,
          ...parsed,
          useInbuiltKey: { ...DEFAULT_SETTINGS.useInbuiltKey, ...(parsed.useInbuiltKey || {}) },
          keys: { ...DEFAULT_SETTINGS.keys, ...(parsed.keys || {}) },
          models: { ...DEFAULT_SETTINGS.models, ...(parsed.models || {}) },
        };
      } catch {
        return { ...DEFAULT_SETTINGS };
      }
    }

    function saveSettings(settings) {
      localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
    }

    let currentSettings = loadSettings();

    function applyTheme(theme) {
      document.documentElement.setAttribute("data-theme", theme === "light" ? "light" : "dark");
    }

    function setActiveProviderButton(provider) {
      const buttons = document.querySelectorAll("#model-select button");
      buttons.forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.provider === provider);
      });
    }

    function setActiveThemeButton(theme) {
      const buttons = document.querySelectorAll("#theme-toggle button");
      buttons.forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.theme === theme);
      });
    }

    // Reflects a provider's On/Off state in its toggle buttons and shows
    // or hides that provider's "Your API Key" field accordingly.
    function setInbuiltToggleState(provider, useInbuilt) {
      const toggle = document.querySelector(`.inbuilt-toggle[data-provider="${provider}"]`);
      if (toggle) {
        toggle.querySelectorAll("button[data-value]").forEach((btn) => {
          const isOn = btn.dataset.value === "on";
          btn.classList.toggle("active", isOn === useInbuilt);
        });
      }
      const field = document.querySelector(`.custom-key-field[data-provider="${provider}"]`);
      if (field) field.classList.toggle("open", !useInbuilt);
    }

    function populateSettingsForm() {
      for (const provider of KEY_PROVIDERS) {
        document.getElementById(`key-${provider}`).value = currentSettings.keys[provider];
        setInbuiltToggleState(provider, currentSettings.useInbuiltKey[provider]);
        const confirmEl = document.getElementById(`save-confirm-${provider}`);
        if (confirmEl) confirmEl.textContent = "";
      }
      document.getElementById("model-gemini").value = currentSettings.models.gemini;
      document.getElementById("model-nvidia").value = currentSettings.models.nvidia;
      document.getElementById("model-groq").value = currentSettings.models.groq;
      setActiveThemeButton(currentSettings.theme);
    }

    // Apply persisted theme/provider immediately on load.
    applyTheme(currentSettings.theme);
    setActiveProviderButton(currentSettings.provider);

    document.getElementById("model-select").addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-provider]");
      if (!btn) return;
      currentSettings.provider = btn.dataset.provider;
      setActiveProviderButton(currentSettings.provider);
      saveSettings(currentSettings);
    });

    const settingsOverlay = document.getElementById("settings-overlay");
    const settingsBtn = document.getElementById("settings-btn");

    settingsBtn.addEventListener("click", () => {
      populateSettingsForm();
      settingsOverlay.classList.add("open");
    });

    document.getElementById("settings-close").addEventListener("click", () => {
      settingsOverlay.classList.remove("open");
    });

    settingsOverlay.addEventListener("click", (e) => {
      if (e.target === settingsOverlay) settingsOverlay.classList.remove("open");
    });

    document.getElementById("theme-toggle").addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-theme]");
      if (!btn) return;
      setActiveThemeButton(btn.dataset.theme);
      applyTheme(btn.dataset.theme);
    });

    // Each provider's On/Off toggle switches immediately (no Save needed
    // to reveal/hide the custom key field), matching the requested
    // "Off: show ... input" behavior.
    document.querySelectorAll(".inbuilt-toggle").forEach((toggle) => {
      toggle.addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-value]");
        if (!btn) return;
        const provider = toggle.dataset.provider;
        const useInbuilt = btn.dataset.value === "on";
        currentSettings.useInbuiltKey[provider] = useInbuilt;
        setInbuiltToggleState(provider, useInbuilt);
      });
    });

    // Pulls every current form control's value into currentSettings.
    // Shared by the per-provider "Save" buttons and the main Save button
    // so both write the same complete, consistent settings object.
    function readFormIntoSettings() {
      for (const provider of KEY_PROVIDERS) {
        currentSettings.keys[provider] = document.getElementById(`key-${provider}`).value.trim();
        // useInbuiltKey[provider] is already kept current by the toggle handler above.
      }
      currentSettings.models.gemini =
        document.getElementById("model-gemini").value.trim() || DEFAULT_SETTINGS.models.gemini;
      currentSettings.models.nvidia =
        document.getElementById("model-nvidia").value.trim() || DEFAULT_SETTINGS.models.nvidia;
      currentSettings.models.groq =
        document.getElementById("model-groq").value.trim() || DEFAULT_SETTINGS.models.groq;
      currentSettings.theme =
        document.querySelector("#theme-toggle button.active")?.dataset.theme || "dark";
    }

    // Builds the request payload's custom_api_keys: only providers whose
    // Inbuilt toggle is Off AND that have a saved key are included. A
    // provider left On (or Off with no key saved yet) is simply omitted,
    // so the backend falls back to its own configured (inbuilt) key for
    // it. Tavily is never included — it has no override, by design.
    function buildCustomApiKeysPayload() {
      const payload = {};
      for (const provider of KEY_PROVIDERS) {
        if (!currentSettings.useInbuiltKey[provider] && currentSettings.keys[provider]) {
          payload[provider] = currentSettings.keys[provider];
        }
      }
      return payload;
    }

    document.querySelectorAll(".save-key-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const provider = btn.dataset.provider;
        readFormIntoSettings();
        saveSettings(currentSettings);
        const confirmEl = document.getElementById(`save-confirm-${provider}`);
        if (confirmEl) {
          confirmEl.textContent = "Saved.";
          setTimeout(() => {
            confirmEl.textContent = "";
          }, 2000);
        }
      });
    });

    document.getElementById("settings-save").addEventListener("click", () => {
      readFormIntoSettings();
      applyTheme(currentSettings.theme);
      saveSettings(currentSettings);
      settingsOverlay.classList.remove("open");
    });

    // --- Speech-to-text (mic button) --------------------------------------
    // Uses the browser's native Web Speech API. Purely client-side: no
    // backend involvement, no API keys. Fills the input with the
    // recognized transcript and never submits automatically — the person
    // still has to review the text and press Send themselves.

    const micBtn = document.getElementById("mic-btn");
    const micBtnLabel = document.getElementById("mic-btn-label");
    const speechLangSelect = document.getElementById("speech-lang-select");

    const SpeechRecognitionCtor = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognition = null;
    let isListening = false;
    let currentSpeechLang = "en-US";

    function setActiveSpeechLangButton(lang) {
      speechLangSelect.querySelectorAll("button[data-lang]").forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.lang === lang);
      });
    }

    speechLangSelect.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-lang]");
      if (!btn) return;
      currentSpeechLang = btn.dataset.lang;
      setActiveSpeechLangButton(currentSpeechLang);
    });

    function startListening() {
      recognition = new SpeechRecognitionCtor();
      recognition.lang = currentSpeechLang;
      recognition.interimResults = true;
      recognition.continuous = false;

      recognition.onstart = () => {
        isListening = true;
        micBtn.classList.add("listening");
        micBtnLabel.textContent = "Listening…";
      };

      recognition.onresult = (event) => {
        let transcript = "";
        for (let i = 0; i < event.results.length; i++) {
          transcript += event.results[i][0].transcript;
        }
        // Fill the input with what was spoken so far; the person reviews
        // and edits it, then presses Send manually — no auto-submit.
        promptInput.value = transcript;
      };

      recognition.onerror = (event) => {
        if (event.error === "no-speech") {
          showError("Didn't catch that — try speaking again.");
        } else if (event.error === "not-allowed" || event.error === "service-not-allowed") {
          showError("Microphone access was blocked. Allow it to use voice input.");
        } else {
          showError(`Speech recognition error: ${event.error}`);
        }
      };

      recognition.onend = () => {
        isListening = false;
        micBtn.classList.remove("listening");
        micBtnLabel.textContent = "Speak";
      };

      recognition.start();
    }

    if (!SpeechRecognitionCtor) {
      micBtn.disabled = true;
      micBtn.title = "Speech input isn't supported in this browser.";
      micBtnLabel.textContent = "Speak (unsupported)";
    } else {
      micBtn.addEventListener("click", () => {
        if (isListening) {
          recognition && recognition.stop();
          return;
        }
        startListening();
      });
    }



    // --- Research pipeline / streaming (unchanged) -----------------------

    function buildProgressList() {
      progressList.innerHTML = "";
      for (const step of STEPS) {
        const li = document.createElement("li");
        li.dataset.node = step.node;
        li.innerHTML = `<span class="dot"></span><span class="label">${step.label}</span>`;
        progressList.appendChild(li);
      }
    }

    function setProgressState(completedNode) {
      const idx = STEPS.findIndex((s) => s.node === completedNode);
      if (idx === -1) return;

      const items = Array.from(progressList.children);
      items.forEach((li, i) => {
        li.classList.remove("active", "done");
        if (i < idx) {
          li.classList.add("done");
        } else if (i === idx) {
          li.classList.add("done");
        } else if (i === idx + 1) {
          li.classList.add("active");
        }
        // Steps after the next one reset to pending (handles retry loops:
        // a repeated "plan" event naturally re-marks search..report pending).
      });
    }

    function resetUI() {
      errorText.style.display = "none";
      errorText.textContent = "";

      buildProgressList();
      progressSection.style.display = "block";
      progressCaption.textContent = "Working on it —";

      reportSection.style.display = "none";
      reportDivider.style.display = "none";
      reportTitle.textContent = "";
      reportSummary.textContent = "";
      keyFindingsEl.innerHTML = "";
      findingsContainer.innerHTML = "";
      sourcesList.innerHTML = "";
    }

    function showError(message) {
      errorText.textContent = message;
      errorText.style.display = "block";
    }

    function hostnameOf(url) {
      try {
        return new URL(url).hostname.replace(/^www\./, "");
      } catch {
        return url;
      }
    }

    function renderReport(report, errors) {
      progressCaption.textContent = "Research complete";

      if (!report) {
        showError(
          errors && errors.length
            ? errors[errors.length - 1]
            : "No report could be produced for this request."
        );
        return;
      }

      reportTitle.textContent = report.title;
      reportSummary.textContent = report.executive_summary;

      keyFindingsEl.innerHTML = "";
      for (const point of report.key_findings || []) {
        const li = document.createElement("li");
        li.textContent = point;
        keyFindingsEl.appendChild(li);
      }

      findingsContainer.innerHTML = "";
      for (const finding of report.findings || []) {
        const block = document.createElement("div");
        block.className = "finding";

        const heading = document.createElement("h4");
        heading.textContent = finding.topic;
        block.appendChild(heading);

        const summary = document.createElement("p");
        summary.textContent = finding.summary;
        block.appendChild(summary);

        if (finding.key_points && finding.key_points.length) {
          const ul = document.createElement("ul");
          for (const kp of finding.key_points) {
            const li = document.createElement("li");
            li.textContent = kp;
            ul.appendChild(li);
          }
          block.appendChild(ul);
        }

        if (finding.sources && finding.sources.length) {
          const sourcesLine = document.createElement("p");
          sourcesLine.className = "finding-sources";
          sourcesLine.innerHTML =
            "Sources: " +
            finding.sources
              .map((url) => `<a href="${url}" target="_blank" rel="noopener">${hostnameOf(url)}</a>`)
              .join(", ");
          block.appendChild(sourcesLine);
        }

        findingsContainer.appendChild(block);
      }

      sourcesList.innerHTML = "";
      for (const url of report.sources || []) {
        const li = document.createElement("li");
        li.innerHTML = `<a href="${url}" target="_blank" rel="noopener">${hostnameOf(url)}</a><span class="source-url">${url}</span>`;
        sourcesList.appendChild(li);
      }

      reportDivider.style.display = "block";
      reportSection.style.display = "block";
    }

    function parseSseBlock(block) {
      let eventName = null;
      let dataLine = null;
      for (const line of block.split("\n")) {
        if (line.startsWith("event:")) eventName = line.slice(6).trim();
        else if (line.startsWith("data:")) dataLine = line.slice(5).trim();
      }
      if (!eventName || dataLine === null) return null;
      try {
        return { event: eventName, data: JSON.parse(dataLine) };
      } catch {
        return null;
      }
    }

    async function runResearch(prompt) {
      resetUI();
      sendBtn.disabled = true;
      sendBtn.textContent = "Researching…";
      promptInput.disabled = true;

      try {
        const response = await fetch(`${API_BASE}/api/research`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            prompt,
            preferred_provider: currentSettings.provider,
            custom_api_keys: buildCustomApiKeysPayload(),
          }),
        });

        if (!response.ok || !response.body) {
          showError(`Request failed (status ${response.status}).`);
          return;
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = "";

        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });

          let boundary;
          while ((boundary = buffer.indexOf("\n\n")) !== -1) {
            const rawBlock = buffer.slice(0, boundary);
            buffer = buffer.slice(boundary + 2);

            const parsed = parseSseBlock(rawBlock);
            if (!parsed) continue;

            if (parsed.event === "progress") {
              if (parsed.data.node && parsed.data.node !== "start") {
                setProgressState(parsed.data.node);
              }
            } else if (parsed.event === "final_report") {
              renderReport(parsed.data.final_report, parsed.data.errors);
            } else if (parsed.event === "error") {
              showError(parsed.data.message || "The research pipeline failed.");
            }
          }
        }
      } catch (err) {
        showError(`Could not reach the research API (${err.message}).`);
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = "Send";
        promptInput.disabled = false;
      }
    }

    sendBtn.addEventListener("click", () => {
      const value = promptInput.value.trim();
      if (!value) {
        showError("Enter a research question first.");
        return;
      }
      runResearch(value);
    });

    promptInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        sendBtn.click();
      }
    });
  </script>
</body>
</html>
