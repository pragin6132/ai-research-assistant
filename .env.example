# Copy this file to .env and fill in real values locally.
# Never commit the actual .env file.

# --- App ---
APP_ENV=development
DEBUG=true

# --- LLM provider API keys (leave blank for now) ---
GEMINI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# --- Search provider API key (leave blank for now) ---
TAVILY_API_KEY=

# --- Search provider (Tavily) configuration ---
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# --- LLM model configuration ---
# Default/primary provider for reference; LLMManager always tries Gemini
# first regardless of this value (see app/services/llm_manager.py).
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.2

# Per-provider model names, used by LLMManager's provider implementations.
GEMINI_MODEL_NAME=gemini-2.5-flash
NVIDIA_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
GROQ_MODEL_NAME=openai/gpt-oss-20b

# --- Image generation provider (Pixazo) ---
PIXAZO_API_KEY=
PIXAZO_IMAGE_MODEL=z-image-base
